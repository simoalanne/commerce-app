<mjml>
    <mj-head>
        <mj-title>{{subject}}</mj-title>
        <mj-preview>{{preview}}</mj-preview>

        <mj-attributes>
            <mj-all font-family="Inter, Helvetica Neue, Arial, sans-serif" />
            <mj-body background-color="#f9f9f9" />
            <mj-section padding="0" />
            <mj-column padding="0" />
            <mj-text color="#1a1c1c" font-size="15px" line-height="1.6" padding="0" />
            <mj-button background-color="#171717" color="#ffffff" border-radius="999px" font-size="15px" font-weight="700" inner-padding="14px 22px" />
            <mj-class name="sectionLabel" font-size="12px" font-weight="800" letter-spacing="1.6px" text-transform="uppercase" color="#171717" />
            <mj-class name="fieldLabel" color="#525252" font-size="13px" font-weight="700" />
            <mj-class name="muted" color="#525252" />
        </mj-attributes>

        <mj-style inline="inline">
            .link a {
                color: #404040;
                text-decoration: underline;
                word-break: break-all;
            }

            .header-link a {
                color: #e5e5e5;
                text-decoration: none;
            }
        </mj-style>
        <mj-style>
            @media only screen and (max-width: 480px) {
                .mobile-outer-padding {
                    padding-left: 8px !important;
                    padding-right: 8px !important;
                }
                .mobile-section-padding {
                    padding-left: 16px !important;
                    padding-right: 16px !important;
                }
                .mobile-header-padding {
                    padding-left: 18px !important;
                    padding-right: 18px !important;
                }
            }
        </mj-style>
    </mj-head>

    <mj-body>
        <mj-section css-class="mobile-outer-padding" padding="24px 12px 0">
            <mj-column>
                <mj-spacer height="1px" />
            </mj-column>
        </mj-section>

        <mj-wrapper background-color="#ffffff" border="1px solid #d4d4d4" border-radius="24px" padding="0">
            <!-- Header -->
            <mj-section css-class="mobile-header-padding" background-color="#262626" border-radius="24px 24px 0 0" padding="30px 24px 28px">
                <mj-column>
                    <mj-text font-size="12px" font-weight="800" letter-spacing="1.8px" text-transform="uppercase" color="#e5e5e5">
                        {{brand.name}}
                    </mj-text>

                    <mj-text font-size="28px" line-height="1.15" font-weight="700" color="#ffffff" padding="12px 0 0">
                        {{subject}}
                    </mj-text>

                    <mj-text font-size="15px" line-height="1.6" color="#f5f5f5" padding="12px 0 0">
                        {{intro}}
                    </mj-text>

                    <mj-button href="{{orderUrl}}" align="left" padding="20px 0 0">
                        {{viewOrderLabel}}
                    </mj-button>

                    <mj-text css-class="header-link" font-size="13px" line-height="1.6" color="#f5f5f5" padding="12px 0 0">
                        {{shopLinkPrefix}} <a href="{{shopUrl}}">{{shopLinkLabel}}</a>
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Delivery details -->
            <mj-section css-class="mobile-section-padding" padding="28px 24px 0">
                <mj-column>
                    <mj-text mj-class="sectionLabel" padding="0 0 14px">
                        {{delivery.title}}
                    </mj-text>

                    <mj-table>
                        <tr>
                            <td style="padding:0;">
                                <div style="font-size:13px;font-weight:400;color:#1a1c1c;margin-bottom:4px;">
                                    {{delivery.addressLabel}}
                                </div>
                                <div style="font-size:13px;font-weight:400;color:#525252;line-height:1.55;">
                                    {{#each delivery.addressLines}}
                                        {{this}}{{#unless @last}}<br />{{/unless}}
                                    {{/each}}
                                </div>
                            </td>
                        </tr>
                    </mj-table>
                </mj-column>
            </mj-section>

            <!-- Ordered items -->
            <mj-section css-class="mobile-section-padding" padding="28px 24px 0">
                <mj-column>
                    <mj-text mj-class="sectionLabel" padding="0 0 10px">
                        {{itemsTitle}}
                    </mj-text>

                    <mj-table>
                        {{#each items}}
                            <tr>
                                <td style="padding:16px 0;{{#unless @last}}border-bottom:1px solid #d4d4d4;{{/unless}}">
                                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                                        <tr>
                                            <td style="width:56px;vertical-align:top;">
                                                {{#if imageUrl}}
                                                    <img src="{{imageUrl}}" alt="{{imageAlt}}" width="48" height="48" style="display:block;width:48px;height:48px;border-radius:10px;object-fit:cover;background:#f3f3f3;" />
                                                {{else}}
                                                    <div style="width:48px;height:48px;border-radius:10px;background:#f3f3f3;color:#171717;font-size:14px;font-weight:800;line-height:48px;text-align:center;">
                                                        {{initials}}
                                                    </div>
                                                {{/if}}
                                            </td>

                                            <td style="vertical-align:top;padding:0 8px;">
                                                <div style="font-size:14px;font-weight:800;color:#1a1c1c;line-height:1.35;word-break:normal;overflow-wrap:break-word;">
                                                    {{name}}
                                                </div>
                                                <div style="font-size:13px;color:#525252;margin-top:3px;line-height:1.4;word-break:normal;overflow-wrap:break-word;">
                                                    {{lineItem}}
                                                </div>
                                                {{#if vendor}}
                                                    <div style="font-size:12px;color:#525252;margin-top:3px;line-height:1.4;word-break:normal;overflow-wrap:break-word;">
                                                        {{vendor}}
                                                    </div>
                                                {{/if}}
                                            </td>

                                            <td style="vertical-align:top;text-align:right;white-space:nowrap;padding-left:8px;">
                                                <div style="font-size:14px;color:#171717;font-weight:800;line-height:1.35;">
                                                    {{total}}
                                                </div>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        {{/each}}
                    </mj-table>
                </mj-column>
            </mj-section>

            <!-- Totals -->
            <mj-section css-class="mobile-section-padding" padding="18px 24px 0">
                <mj-column>
                    <mj-table font-size="15px" line-height="1.6">
                        <tr>
                            <td style="padding:6px 0;color:#525252;">{{totals.subtotalLabel}}</td>
                            <td style="padding:6px 0;text-align:right;color:#525252;white-space:nowrap;">{{totals.subtotal}}</td>
                        </tr>
                        <tr>
                            <td style="padding:6px 0;color:#525252;">{{totals.deliveryFeeLabel}}</td>
                            <td style="padding:6px 0;text-align:right;color:#525252;white-space:nowrap;">{{totals.deliveryFee}}</td>
                        </tr>

                        {{#if totals.tip}}
                            <tr>
                                <td style="padding:6px 0;color:#525252;">{{totals.tipLabel}}</td>
                                <td style="padding:6px 0;text-align:right;color:#525252;white-space:nowrap;">{{totals.tip}}</td>
                            </tr>
                        {{/if}}

                        <tr>
                            <td style="padding:14px 0 0;font-size:17px;font-weight:800;color:#171717;border-top:1px solid #d4d4d4;">
                                {{totals.totalLabel}}
                            </td>
                            <td style="padding:14px 0 0;text-align:right;font-size:17px;font-weight:800;color:#171717;border-top:1px solid #d4d4d4;white-space:nowrap;">
                                {{totals.total}}
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:4px 0 0;color:#525252;font-size:13px;">
                                {{totals.includedVatLabel}}
                            </td>
                            <td style="padding:4px 0 0;text-align:right;color:#525252;font-size:13px;white-space:nowrap;">
                                {{totals.includedVat}}
                            </td>
                        </tr>
                    </mj-table>
                </mj-column>
            </mj-section>

            <!-- Fallback link for email clients that do not render buttons reliably. -->
            <mj-section css-class="mobile-section-padding" padding="24px 24px 0">
                <mj-column>
                    <mj-text mj-class="muted" font-size="13px" line-height="1.6" padding="0">
                        {{paymentReceiptText}}
                    </mj-text>

                    <mj-text css-class="link" font-size="13px" line-height="1.6" color="#404040" padding="10px 0 0">
                        <a href="{{orderUrl}}">{{orderUrl}}</a>
                    </mj-text>
                </mj-column>
            </mj-section>

            <mj-section css-class="mobile-section-padding" padding="24px 24px 28px">
                <mj-column>
                    <mj-text css-class="link" font-size="12px" line-height="1.7" color="#525252" padding="0 0 16px">
                        {{{helpText}}}
                    </mj-text>

                    <mj-text css-class="link" font-size="12px" line-height="1.6" color="#525252">
                        {{recipientLabel}} <a href="mailto:{{customer.email}}">{{customer.email}}</a>
                    </mj-text>
                </mj-column>
            </mj-section>
        </mj-wrapper>

        <mj-section css-class="mobile-outer-padding" padding="0 12px 24px">
            <mj-column>
                <mj-spacer height="1px" />
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
