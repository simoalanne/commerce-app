<mjml>
    <mj-head>
        <mj-title>{{subject}}</mj-title>
        <mj-preview>{{title}}</mj-preview>
        <mj-style inline="inline">
            .url-text a {
                color: #404040;
                text-decoration: underline;
                word-break: break-all;
            }
        </mj-style>
        <mj-attributes>
            <mj-all font-family="Inter, Helvetica Neue, Arial, sans-serif" />
            <mj-text color="#1a1c1c" font-size="15px" line-height="1.6" padding="0" />
            <mj-button background-color="#171717" color="#ffffff" border-radius="999px" font-size="15px" font-weight="700" inner-padding="14px 22px" />
        </mj-attributes>
    </mj-head>
    <mj-body background-color="#f9f9f9">
        <mj-section padding="32px 16px 0">
            <mj-column>
                <mj-spacer height="1px" />
            </mj-column>
        </mj-section>
        <mj-wrapper css-class="card" background-color="#ffffff" border="1px solid #d4d4d4" border-radius="24px" padding="0">
            <mj-section background-color="#262626" padding="34px 32px 30px" border-radius="24px 24px 0 0">
                <mj-column>
                    <mj-text font-size="12px" font-weight="800" letter-spacing="2px" text-transform="uppercase" color="#e5e5e5" padding="0">
                        {{eyebrow}}
                    </mj-text>
                    <mj-text font-size="30px" line-height="1.08" font-weight="700" color="#ffffff" padding="14px 0 0">
                        {{title}}
                    </mj-text>
                </mj-column>
            </mj-section>
            <mj-section padding="32px">
                <mj-column>
                    <mj-text font-size="15px" line-height="1.6" color="#525252" padding="0 0 24px">
                        {{body}}
                    </mj-text>
                    <mj-button href="{{reviewUrl}}" align="left" padding="0">
                        {{ctaLabel}}
                    </mj-button>
                    <mj-text font-size="13px" line-height="1.6" color="#525252" padding="24px 0 0">
                        {{linkFallback}}
                    </mj-text>
                    <mj-text css-class="url-text" font-size="13px" line-height="1.6" color="#404040" padding="8px 0 0">
                        <a href="{{reviewUrl}}">{{reviewUrl}}</a>
                    </mj-text>
                </mj-column>
            </mj-section>
        </mj-wrapper>
        <mj-section padding="0 16px 32px">
            <mj-column>
                <mj-spacer height="1px" />
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
