{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.ts",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./routes": "./src/routes.ts",
    "./contracts/*": "./generated/contracts/*"
  },
  "scripts": {
    "test:db:init": "DATABASE_URL=postgresql://postgres:postgres@localhost:5433/acme_test drizzle-kit push --force",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "dev": "bun --watch --preload ./src/instrument.ts src/index.ts",
    "start": "bun --preload ./src/instrument.ts src/index.ts",
    "seed": "bun scripts/seed.ts",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc",
    "contract": "bun scripts/extract-contracts.ts",
    "contract:watch": "bun --watch scripts/extract-contracts.ts",
    "grantAdmin": "bun scripts/grantAdmin.ts",
    "registerStripeWebhook": "bun scripts/registerStripeWebhook.ts",
    "deleteStripeWebhook": "bun scripts/deleteStripeWebhook.ts",
    "postinstall": "bun scripts/extract-contracts.ts"
  },
  "dependencies": {
    "@acme/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@clerk/backend": "^3.31.4",
    "@react-email/components": "^1.0.12",
    "@rest-rpc/server": "0.8.1",
    "@scalar/client-side-rendering": "^0.4.22",
    "@sentry/node": "^11.16.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "1.0.0-rc.6",
    "ip-address": "^10.7.6",
    "jose": "^6.2.18",
    "p-map": "^7.1.1",
    "pdfmake": "^0.3.15",
    "pg": "^8.23.1",
    "pg-boss": "12.40.0",
    "rate-limiter-flexible": "^11.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.39.0",
    "stripe": "^23.2.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "1.0.0-rc.6",
    "vitest": "^5.1.2"
  }
}
