{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.ts",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./routes": "./src/routes.ts",
    "./contracts/*": "./generated/contracts/*"
  },
  "scripts": {
    "test:db:init": "prisma db push --url 'postgresql://postgres:postgres@localhost:5433/acme_test' --accept-data-loss",
    "test": "node --import ./src/tests/setup.ts --test --test-global-setup=./src/tests/globalSetup.ts \"src/**/*.test.ts\"",
    "test:unit": "node --test \"src/**/*.unit.test.ts\"",
    "test:integration": "node --import ./src/tests/setup.ts --test --test-global-setup=./src/tests/globalSetup.ts \"src/**/*.integration.test.ts\"",
    "start": "bun --preload ./src/instrument.ts src/index.ts",
    "typecheck": "tsc",
    "contract": "node scripts/extract-contracts.ts",
    "contract:watch": "node --watch scripts/extract-contracts.ts",
    "grantAdmin": "node scripts/grantAdmin.ts",
    "registerStripeWebhook": "node scripts/registerStripeWebhook.ts",
    "deleteStripeWebhook": "node scripts/deleteStripeWebhook.ts",
    "postinstall": "node scripts/extract-contracts.ts"
  },
  "dependencies": {
    "@acme/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@clerk/backend": "^3.31.4",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@rest-rpc/server": "0.8.1",
    "@scalar/client-side-rendering": "^0.4.22",
    "@sentry/node": "^11.16.0",
    "dotenv": "^18.0.10",
    "handlebars": "^4.7.10",
    "ip-address": "^10.7.6",
    "jose": "^6.2.18",
    "mjml": "^5.4.1",
    "p-map": "^7.1.1",
    "pdfmake": "^0.3.15",
    "pg": "^8.23.1",
    "rate-limiter-flexible": "^11.5.0",
    "resend": "^6.39.0",
    "stripe": "^23.2.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/mjml": "^5.4.2",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "esmock": "^3.0.0",
    "prisma": "^7.10.1",
    "prisma-json-types-generator": "^6.0.1"
  }
}
