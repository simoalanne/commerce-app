# Environment variables for backend application
# For deployment everything except configuration variables (port email delay, etc.) MUST be set.
# Local development needs none of them: every integration has a local default
# (filesystem storage, console email, dev payments). Only auth still needs Clerk.

# Database connection URL
# This is mandatory and should point to your local or remote Postgres database.
# Defaults to the compose development database below (docker compose up in the repo root).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acme_dev"

# Optional auth integration
# If unset, authenticated routes will not work.
CLERK_SECRET_KEY="sk_test_<SecretKey>"
CLERK_PUBLISHABLE_KEY="pk_test_<PublishableKey>"

# Optional Stripe payments integration
# Secret key is required for any payment features to work.
# Webhook secret is required for handling webhooks from Stripe.
# Deployment needs both secrets to be set up for payments to work correctly and securely.
STRIPE_SECRET_KEY="sk_test_<StripeSecretKey>"
STRIPE_WEBHOOK_SECRET="whsec_<StripeWebhookSecret>"

# Optional Paytrail payments integration
# For development, the test credentials below can be used.
# The API_PUBLIC_URL must be https so for local testing some tunneling solution like ngrok should work.
# For production the merchant ID and secret key must be obtained from Paytrail and set up here and the API_PUBLIC_URL should point to the deployed backend.
PAYTRAIL_MERCHANT_ID="375917"
PAYTRAIL_MERCHANT_NAME="Acme"
PAYTRAIL_SECRET_KEY="SAIPPUAKAUPPIAS"
API_PUBLIC_URL="https://api.example.com"

# Optional email integration
# If unset, email sending features will not work.
RESEND_API_KEY="re_<ResendApiKey>"
RESEND_FROM_EMAIL="orders@example.com"
RESEND_FROM_NAME="Acme"
RESEND_REPLY_TO_EMAIL="support@example.com"
ONLINE_STORE_URL="http://localhost:3000/" # "https://store.example.com"
INTERNAL_API_KEY="<SharedInternalApiKeyAtLeast32Chars>"
DASHBOARD_URL="https://dashboard.example.com"

# Optional behavior overrides for email sending
# Paid orders count as shipped after this delay, until shipping is modeled.
ORDER_SHIP_DELAY_SECONDS="60"
# The review invitation goes out this long after an order ships.
REVIEW_INVITATION_DELAY_SECONDS="0"

# Optional object storage integration.
# Required for uploading any images in dashboard.
OBJECT_STORAGE_R2_ACCOUNT_ID="<CloudflareAccountId>"
OBJECT_STORAGE_R2_ACCESS_KEY_ID="<R2AccessKeyId>"
OBJECT_STORAGE_R2_BUCKET="example-bucket"
OBJECT_STORAGE_R2_PUBLIC_BASE_URL="https://media.example.com"
OBJECT_STORAGE_R2_SECRET_ACCESS_KEY="<R2SecretAccessKey>"

# Optional JWT secret for signing tokens.
# Used for order access tokens in emailed links.
JWT_SECRET="<JWTSecretKey>"

# Optional runtime config
PORT=3001
NODE_ENV="development"
LOG_LEVEL="minimal"

# Optional recipient for internal company notifications.
# Defaults to hello@example.com when unset.
COMPANY_CONTACT_EMAIL="info@example.com"

# Controls whether paid orders generate internal new-order notification emails.
# Disabled by default; enable explicitly in the intended deployment environment.
NEW_ORDER_NOTIFICATION_EMAIL_ENABLED="false"
