# Non-secret local defaults, loaded by Next only in development. Put secrets
# (Clerk keys) and overrides in .env.local, which is gitignored.
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_OPTIMIZE_IMAGES="false"
# Must match the backend's .env.development.
INTERNAL_API_KEY="local-development-internal-api-key"
