{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "node",
    "react",
    "jsx-a11y"
  ],
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["**/generated/**", "**/*.d.ts"],
  "overrides": [
    {
      "files": ["apps/online-store/**"],
      "plugins": ["nextjs"]
    },
    {
      "files": ["**/*.test.ts", "**/tests/**"],
      "rules": {
        "typescript/no-floating-promises": "off"
      }
    }
  ]
}
